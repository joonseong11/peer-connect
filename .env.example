# ── Supabase ──────────────────────────────────────────────
# Supabase 프로젝트 Settings > API 에서 복사
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (서버 전용). 계정 삭제, cron digest 등에 필요.
# 생략 시 admin 기능 비활성화 (앱은 정상 동작)
SUPABASE_SERVICE_ROLE_KEY=

# ── Application URL ───────────────────────────────────────
# 이메일 알림 링크에 사용. 로컬 개발 시 http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# ── Email (Resend) ────────────────────────────────────────
# 생략 시 이메일 발송 비활성화 (콘솔 경고만 출력)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Peer Connect <noreply@your-domain.com>
RESEND_REPLY_TO_EMAIL=

# ── Invite System ─────────────────────────────────────────
# 첫 번째 사용자용 부트스트랩 초대 코드 (일회성). 선택사항.
INVITE_FALLBACK_CODE=
# 무제한 초대 슬롯을 받는 사용자 ID (쉼표 구분). 선택사항.
INVITE_UNLIMITED_USER_IDS=
